[
  {
    "id": "editorial-friends-fit-001",
    "audience": "friends",
    "level": 1,
    "text": "最近、私たちで話していて楽しかったことは？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-002",
    "audience": "friends",
    "level": 1,
    "text": "私たちが次に会うなら、どの時間帯が過ごしやすい？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-003",
    "audience": "friends",
    "level": 1,
    "text": "次に一緒にご飯を食べるなら、何を選びたい？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-004",
    "audience": "friends",
    "level": 1,
    "text": "私たちの会話では、話す時間と聞く時間のバランスはどう感じる？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-005",
    "audience": "friends",
    "level": 1,
    "text": "私たちで出かけるなら、今いちばん行きたい場所は？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-006",
    "audience": "friends",
    "level": 1,
    "text": "私たちで同じ作品を楽しむなら、何を選びたい？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-007",
    "audience": "friends",
    "level": 1,
    "text": "私たちでゆっくり話すなら、どんな場所がよさそう？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-008",
    "audience": "friends",
    "level": 1,
    "text": "私といる時、自分のどんな一面が出ていると思う？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-009",
    "audience": "friends",
    "level": 1,
    "text": "私たちの会話に、いつの間にか定着した言葉や癖はある？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-010",
    "audience": "friends",
    "level": 1,
    "text": "私たちで写真を撮るなら、どんな一枚を残したい？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-011",
    "audience": "friends",
    "level": 1,
    "text": "私たちで気軽に始めてみたいことは何？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-012",
    "audience": "friends",
    "level": 1,
    "text": "私からどんなメッセージが届くとうれしい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-013",
    "audience": "friends",
    "level": 1,
    "text": "私たちのお出かけは、どこまで予定を決めておくと楽？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-014",
    "audience": "friends",
    "level": 1,
    "text": "次の季節に、私たちで楽しんでみたいことは？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-015",
    "audience": "friends",
    "level": 1,
    "text": "一緒に過ごした中で、今思い出して笑える場面はある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-016",
    "audience": "friends",
    "level": 1,
    "text": "私たちが無言で過ごす時間を、どう感じている？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-017",
    "audience": "friends",
    "level": 1,
    "text": "私に教えてもらって、一緒に試したいことはある？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-018",
    "audience": "friends",
    "level": 1,
    "text": "今の私たちの付き合いで、気に入っているところを一つ挙げるなら？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-019",
    "audience": "friends",
    "level": 1,
    "text": "私たちで過ごした後、どんな気持ちで帰れるとうれしい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-020",
    "audience": "friends",
    "level": 1,
    "text": "私と過ごす時、先に知っておいてほしい苦手なことはある？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-021",
    "audience": "friends",
    "level": 1,
    "text": "私たちがいつもと違う遊びを試すなら、何がよさそう？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-022",
    "audience": "friends",
    "level": 1,
    "text": "最近の私たちの会話で、もう少し話したい話題は？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-023",
    "audience": "friends",
    "level": 1,
    "text": "お互いの趣味を一緒に楽しむなら、どこから試したい？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-024",
    "audience": "friends",
    "level": 1,
    "text": "私たちの待ち合わせで、変えると楽になりそうなことは？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-025",
    "audience": "friends",
    "level": 1,
    "text": "私たちでお店を選ぶ時、大切にしたい条件は？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-026",
    "audience": "friends",
    "level": 1,
    "text": "私たちでゲームをするなら、どんな遊び方が楽しそう？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-028",
    "audience": "friends",
    "level": 1,
    "text": "私たちがつい長く話してしまう話題は何？",
    "category": "friendsDaily",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-030",
    "audience": "friends",
    "level": 1,
    "text": "私が「あなたらしい」と感じていそうなのは、どんなところ？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-031",
    "audience": "friends",
    "level": 1,
    "text": "私といる時、気を張らずに過ごせていると感じる？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-032",
    "audience": "friends",
    "level": 1,
    "text": "私の行動で、いいなと思ったことはある？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-033",
    "audience": "friends",
    "level": 1,
    "text": "私たちの間で、自然に大切にしている約束はある？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-034",
    "audience": "friends",
    "level": 1,
    "text": "私が落ち込んでいる時、どんな声のかけ方なら自分も無理がない？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-035",
    "audience": "friends",
    "level": 1,
    "text": "私にしてもらってうれしかった、小さなことはある？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-036",
    "audience": "friends",
    "level": 1,
    "text": "私たちの会話で、話し終えるまで待ってほしい時はある？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-037",
    "audience": "friends",
    "level": 1,
    "text": "私に今、ありがとうと伝えたいことはある？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-038",
    "audience": "friends",
    "level": 1,
    "text": "私の様子がいつもと違う時、どんなふうに聞いてみたい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-039",
    "audience": "friends",
    "level": 1,
    "text": "私たちが初めて話した時、どんな印象だった？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-040",
    "audience": "friends",
    "level": 1,
    "text": "私たちで一緒に喜んだ出来事はある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-041",
    "audience": "friends",
    "level": 1,
    "text": "私たちでうまくいかなかったことから、今に生かせそうなものはある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-042",
    "audience": "friends",
    "level": 1,
    "text": "私たちが一緒に写った写真で、気に入っているものはある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-043",
    "audience": "friends",
    "level": 1,
    "text": "私たちのメッセージは、どんなペースだと無理がない？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-044",
    "audience": "friends",
    "level": 1,
    "text": "私との会話で、今は触れずにおきたい話題はある？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-045",
    "audience": "friends",
    "level": 1,
    "text": "私からの誘いを断る時、どんな反応だと気が楽？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-048",
    "audience": "friends",
    "level": 2,
    "text": "私たちが気軽に話せるのは、どんな雰囲気の時？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-049",
    "audience": "friends",
    "level": 2,
    "text": "私に相談するなら、どんな聞き方をしてほしい？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-050",
    "audience": "friends",
    "level": 2,
    "text": "私たちの約束で、事前にはっきりさせたいことは？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-051",
    "audience": "friends",
    "level": 2,
    "text": "私に合わせて、自分の希望を言いそびれることはある？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-052",
    "audience": "friends",
    "level": 2,
    "text": "私たちの意見が違った時、どんな話し方なら落ち着ける？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-054",
    "audience": "friends",
    "level": 2,
    "text": "私たちの気分が違う日、どんな過ごし方なら楽？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-056",
    "audience": "friends",
    "level": 2,
    "text": "私たちの間が気まずい時、次の連絡はどうしてもらえると楽？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-057",
    "audience": "friends",
    "level": 2,
    "text": "急な誘いをする時、私に気をつけてほしいことは？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-058",
    "audience": "friends",
    "level": 2,
    "text": "私から何か伝えるなら、どんな言い方が受け止めやすい？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-059",
    "audience": "friends",
    "level": 2,
    "text": "今挑戦していることがあれば、私にどんな関わり方を望む？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-060",
    "audience": "friends",
    "level": 2,
    "text": "私たちの関わり方が変わったと感じる時期はある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-061",
    "audience": "friends",
    "level": 2,
    "text": "私をうらやましく感じることがあるなら、どんな距離で付き合うと楽？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-062",
    "audience": "friends",
    "level": 2,
    "text": "私たちが親しくても、それぞれに残しておきたい領域は？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-063",
    "audience": "friends",
    "level": 2,
    "text": "私を頼ってもよいと思えるのは、どんな時？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-064",
    "audience": "friends",
    "level": 2,
    "text": "今の私たちの付き合いを、無理なく続けるために必要なことは？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-065",
    "audience": "friends",
    "level": 2,
    "text": "私たちの予定を変えたい時、どんな連絡だと助かる？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-066",
    "audience": "friends",
    "level": 2,
    "text": "私たちの間で行き違いがあったら、どう話すきっかけを作りたい？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-067",
    "audience": "friends",
    "level": 2,
    "text": "私からの返信が遅い時、どんなふうに受け止めている？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-068",
    "audience": "friends",
    "level": 2,
    "text": "私にまだ話していないことを話すなら、どんな場面がよさそう？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-069",
    "audience": "friends",
    "level": 2,
    "text": "私たちの会話で、もっと自分から話してみたいことはある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-070",
    "audience": "friends",
    "level": 2,
    "text": "私たちが会話を楽しめるのは、どんなきっかけがある時？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-071",
    "audience": "friends",
    "level": 2,
    "text": "私たちでお金を使う時、金額の決め方で相談したいことはある？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-072",
    "audience": "friends",
    "level": 2,
    "text": "私の話を聞いて、自分の選択肢が広がったことはある？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-074",
    "audience": "friends",
    "level": 2,
    "text": "私たちの好みが違っても、気兼ねなく話せると感じる？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-075",
    "audience": "friends",
    "level": 2,
    "text": "私たちで助け合えたと感じる場面はある？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-076",
    "audience": "friends",
    "level": 2,
    "text": "私にうれしい出来事があった時、どんなふうに共有するのが二人に合う？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-077",
    "audience": "friends",
    "level": 2,
    "text": "私に弱音を話す時、どんな安心があると話しやすい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-078",
    "audience": "friends",
    "level": 2,
    "text": "最近、私の中で気づいた小さな変化はある？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-079",
    "audience": "friends",
    "level": 2,
    "text": "私の話を聞く余裕がない日は、どう伝えたい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-081",
    "audience": "friends",
    "level": 2,
    "text": "私の頼みを断るなら、どんな言葉が言いやすい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-082",
    "audience": "friends",
    "level": 2,
    "text": "私たちがお互いを比べる時、どんな話題が気になりやすい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-083",
    "audience": "friends",
    "level": 2,
    "text": "今の私たちの距離感を、どう感じている？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-084",
    "audience": "friends",
    "level": 2,
    "text": "私と過ごしたい日と、一人でいたい日はどう知らせたい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-085",
    "audience": "friends",
    "level": 2,
    "text": "私に話したことを、二人の間だけにしてほしい時はどう伝えたい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-086",
    "audience": "friends",
    "level": 2,
    "text": "私たちが前より親しくなったと感じた場面はある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-087",
    "audience": "friends",
    "level": 2,
    "text": "私たちの思い出の場所で、また行ってみたいところはある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-088",
    "audience": "friends",
    "level": 2,
    "text": "私からの言葉で、今も覚えているものはある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-090",
    "audience": "friends",
    "level": 2,
    "text": "会う頻度が変わった時、私たちの連絡の仕方はどう変わった？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-091",
    "audience": "friends",
    "level": 2,
    "text": "私たちの以前のやりとりで、今なら違う伝え方をしたいことはある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-092",
    "audience": "friends",
    "level": 3,
    "text": "私たちの大事な選択が違う時、どんな付き合い方を続けたい？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-095",
    "audience": "friends",
    "level": 3,
    "text": "私と話す時、自分を少し作っていると感じる場面はある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-096",
    "audience": "friends",
    "level": 3,
    "text": "私たちの生活環境が変わっても、残したい付き合い方は？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-098",
    "audience": "friends",
    "level": 3,
    "text": "私が落ち込んでいる時、言葉以外でできそうな関わり方は？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-099",
    "audience": "friends",
    "level": 3,
    "text": "私たちの間で話しづらくなったことがあれば、どう扱いたい？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-100",
    "audience": "friends",
    "level": 3,
    "text": "私たちの期待する過ごし方が合わない時、どんな調整ができそう？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-102",
    "audience": "friends",
    "level": 3,
    "text": "私と知り合って、自分の考え方が変わったことはある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-103",
    "audience": "friends",
    "level": 3,
    "text": "これから私たちで、どんな思い出を作りたい？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-104",
    "audience": "friends",
    "level": 3,
    "text": "私が自分を責めている時、どんな聞き方が自分にはできそう？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-105",
    "audience": "friends",
    "level": 3,
    "text": "私の選択に賛成できない時、どこまで関わりたい？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-106",
    "audience": "friends",
    "level": 3,
    "text": "私たちが対等に付き合えていると感じるのは、どんな場面？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-107",
    "audience": "friends",
    "level": 3,
    "text": "私から頼られることが負担になったら、どう知らせたい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-108",
    "audience": "friends",
    "level": 3,
    "text": "私たちの出来事で、大切に覚えていたいものは？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-109",
    "audience": "friends",
    "level": 3,
    "text": "これから私たちは、どんな距離感で付き合っていきたい？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-110",
    "audience": "friends",
    "level": 3,
    "text": "今の私たちの関係に、もう少しあるとうれしいものは？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-111",
    "audience": "friends",
    "level": 3,
    "text": "私にもう少し知ってもらいたい、自分の一面はある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-112",
    "audience": "friends",
    "level": 3,
    "text": "私たちの考え方の違いで、面白いと感じたものはある？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-115",
    "audience": "friends",
    "level": 3,
    "text": "私たちのどちらかが変わったと感じた時、何を聞いてみたい？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-116",
    "audience": "friends",
    "level": 3,
    "text": "私たちの間で信頼を感じるのは、どんなやりとり？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-117",
    "audience": "friends",
    "level": 3,
    "text": "私の相談が重く感じられたら、どんなふうに伝えたい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-119",
    "audience": "friends",
    "level": 3,
    "text": "私たちの間で同じ行き違いが続いたら、どう話し合いたい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-121",
    "audience": "friends",
    "level": 3,
    "text": "私との付き合いで、今より負担を減らせるところはある？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-122",
    "audience": "friends",
    "level": 3,
    "text": "私たちの間の誤解を話すなら、どんな場面だと落ち着ける？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-124",
    "audience": "friends",
    "level": 3,
    "text": "私に本音を話す前に、どんな反応が気になる？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-125",
    "audience": "friends",
    "level": 3,
    "text": "私にはまだ見せていないけれど、見せてもよいと思う一面はある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-126",
    "audience": "friends",
    "level": 3,
    "text": "私たちの間で、話す時期を見計らっていることはある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-127",
    "audience": "friends",
    "level": 3,
    "text": "私からの期待が負担に感じられることはある？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-129",
    "audience": "friends",
    "level": 3,
    "text": "私たちが互いのことに関わる時、どこから先は本人に任せたい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-130",
    "audience": "friends",
    "level": 3,
    "text": "私との付き合いで、自分の都合が後回しになると感じることはある？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-131",
    "audience": "friends",
    "level": 3,
    "text": "私たちの今の付き合い方が合っているか、何を手がかりにしている？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-132",
    "audience": "friends",
    "level": 3,
    "text": "これから私たちが連絡を取り合うなら、どんな方法が続けやすい？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-133",
    "audience": "friends",
    "level": 3,
    "text": "私たちで会う時間と、それぞれの時間をどう両立したい？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-134",
    "audience": "friends",
    "level": 3,
    "text": "年を重ねた私たちは、どんな時間を一緒に楽しめそう？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-136",
    "audience": "friends",
    "level": 3,
    "text": "私たちの間で、今も確かめておきたい誤解はある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-137",
    "audience": "friends",
    "level": 3,
    "text": "私たちが以前話したことを、今も同じように扱ってよいと思う？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-138",
    "audience": "friends",
    "level": 3,
    "text": "私たちの昔の写真を見ると、何に目が向く？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-139",
    "audience": "friends",
    "level": 3,
    "text": "私たちの出会った頃と今で、付き合い方にどんな変化がある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-140",
    "audience": "friends",
    "level": 4,
    "text": "私たちのやりとりで傷ついた時、どんな距離が必要になると思う？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-141",
    "audience": "friends",
    "level": 4,
    "text": "私に気持ちを分かってほしかった場面はある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-143",
    "audience": "friends",
    "level": 4,
    "text": "私たちの間で、改めて言葉にしておきたい約束は？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-144",
    "audience": "friends",
    "level": 4,
    "text": "私のつらい話を聞く時、自分を守るために必要なことは？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-145",
    "audience": "friends",
    "level": 4,
    "text": "私たちの間で許せないことがあった時、すぐに結論を出さずに考えたい？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-146",
    "audience": "friends",
    "level": 4,
    "text": "私たちが別々の道に進むとしたら、どんなつながりを残したい？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-147",
    "audience": "friends",
    "level": 4,
    "text": "私たちの付き合いで、寂しさを感じることはある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-148",
    "audience": "friends",
    "level": 4,
    "text": "私たちの距離を見直したい時、どんなふうに知らせたい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-149",
    "audience": "friends",
    "level": 4,
    "text": "私から助けを求められても余裕がない時、どう伝えたい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-151",
    "audience": "friends",
    "level": 4,
    "text": "私に理解されなくても、自分で決めておきたいことはある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-152",
    "audience": "friends",
    "level": 4,
    "text": "私たちの頼みごとで、負担が偏っていると感じる部分はある？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-153",
    "audience": "friends",
    "level": 4,
    "text": "私たちの会話の中で、今も心に残っている言葉は？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-154",
    "audience": "friends",
    "level": 4,
    "text": "私たちの約束で、これからも続けたいものはある？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-155",
    "audience": "friends",
    "level": 4,
    "text": "私との関係で、変えてもよい部分と守りたい部分は何？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-156",
    "audience": "friends",
    "level": 4,
    "text": "私が大丈夫と言った時、その言葉をどんなふうに受け止めたい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-157",
    "audience": "friends",
    "level": 4,
    "text": "今の私たちだからこそ、話してもよいと思えることはある？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-158",
    "audience": "friends",
    "level": 4,
    "text": "もし私たちが距離を置いた後に話すなら、何から確かめたい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-159",
    "audience": "friends",
    "level": 4,
    "text": "これからの私たちの付き合いで、一番大切にしたいことは？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-160",
    "audience": "friends",
    "level": 4,
    "text": "私たちのどちらかが相手を傷つけたと気づいた時、どう話を始めたい？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-161",
    "audience": "friends",
    "level": 4,
    "text": "私たちが互いを比べてしまう時、どんな距離を取れると楽？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-162",
    "audience": "friends",
    "level": 4,
    "text": "私たちの関係を続けるか迷ったら、何を大切に考えたい？",
    "category": "friendsCommunication",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-163",
    "audience": "friends",
    "level": 4,
    "text": "私との会話で、説明せずに守っておきたいことはある？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-165",
    "audience": "friends",
    "level": 4,
    "text": "私たちが少し距離を置くとしたら、連絡の仕方をどう決めたい？",
    "category": "friendsBoundaries",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-166",
    "audience": "friends",
    "level": 4,
    "text": "私たちの相談が二人だけでは難しい時、誰の力を借りたい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-167",
    "audience": "friends",
    "level": 4,
    "text": "私に弱いところを話すなら、どんな受け止め方をしてほしい？",
    "category": "friendsCare",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-170",
    "audience": "friends",
    "level": 4,
    "text": "私からの頼みが自分の考えと合わない時、どう伝えたい？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-172",
    "audience": "friends",
    "level": 4,
    "text": "私に知られている自分と、自分が感じる自分に違いはある？",
    "category": "friendsValues",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-173",
    "audience": "friends",
    "level": 4,
    "text": "もし私たちの連絡が自然に減ったら、その変化をどう扱いたい？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-174",
    "audience": "friends",
    "level": 4,
    "text": "10年後の私たちに、今から残しておきたいものは何？",
    "category": "friendsFuture",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-175",
    "audience": "friends",
    "level": 4,
    "text": "私たちの過去のやりとりで、今の距離感に影響していることはある？",
    "category": "friendsMemories",
    "source": "editorial"
  },
  {
    "id": "editorial-friends-fit-177",
    "audience": "friends",
    "level": 4,
    "text": "私と知り合った頃に比べて、自分らしさの出し方は変わった？",
    "category": "friendsMemories",
    "source": "editorial"
  }
]
